[Unit]
Description=GR-0X ROS 2 Motor Node
After=gr0x-can.service
Requires=gr0x-can.service

[Service]
Type=simple
User=gr0x-pi
Environment="HOME=/home/gr0x-pi"
ExecStart=/bin/bash -c '\
  source /opt/ros/jazzy/setup.bash && \
  source /home/gr0x-pi/gr0x-ws/install/setup.bash && \
  ros2 run gr0x_motor_node gr0x_motor_node'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

